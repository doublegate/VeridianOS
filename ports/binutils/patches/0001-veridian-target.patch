From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: VeridianOS <veridian@veridian-os.org>
Date: Mon, 17 Feb 2026 00:00:00 +0000
Subject: [PATCH] Add VeridianOS target support to binutils

Teach binutils 2.47 to recognize x86_64-veridian, aarch64-veridian,
and riscv64-veridian as valid cross-compilation targets.

Modified files:
  - config.sub: Recognize veridian as a valid OS component in the
    canonical triple.
  - bfd/config.bfd: Define BFD target vectors for all three
    architectures so the linker and other BFD consumers can handle
    VeridianOS ELF files.
  - gas/configure.tgt: Set ELF object format for veridian targets.
  - ld/configure.tgt: Set linker emulations for veridian targets.
---
 config.sub        |  3 ++-
 bfd/config.bfd    | 21 +++++++++++++++++++++
 gas/configure.tgt |  3 +++
 ld/configure.tgt  | 12 ++++++++++++
 4 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/config.sub b/config.sub
--- a/config.sub
+++ b/config.sub
@@ -2141,6 +2141,7 @@
 	| uwin* \
 	| uxpv* \
 	| v88r* \
+	| veridian* \
 	|*vms* \
 	| vos* \
 	| vsta* \
diff --git a/bfd/config.bfd b/bfd/config.bfd
--- a/bfd/config.bfd
+++ b/bfd/config.bfd
@@ -249,6 +249,11 @@
     targ_archs="$targ_archs bfd_i386_arch bfd_powerpc_arch bfd_rs6000_arch"
     want64=true
     ;;
+  aarch64-*-veridian*)
+    targ_defvec=aarch64_elf64_le_vec
+    targ_selvecs="aarch64_elf64_be_vec aarch64_elf32_le_vec aarch64_elf32_be_vec"
+    want64=true
+    ;;
   aarch64-*-elf | aarch64-*-linux* | aarch64-*-netbsd* | aarch64-*-gnu* | aarch64-*-nto* | aarch64-*-rtems* | aarch64-*-genode*)
     targ_defvec=aarch64_elf64_le_vec
     targ_selvecs="aarch64_elf64_be_vec aarch64_elf32_le_vec aarch64_elf32_be_vec arm_elf32_le_vec arm_elf32_be_vec aarch64_pei_le_vec aarch64_pe_le_vec"
@@ -1102,6 +1107,16 @@
     ;;
 
 #ifdef BFD64
+  riscv64-*-veridian*)
+    targ_defvec=riscv_elf64_vec
+    targ_selvecs="riscv_elf32_vec riscv_elf64_be_vec riscv_elf32_be_vec"
+    want64=true
+    ;;
+  riscv32-*-veridian*)
+    targ_defvec=riscv_elf32_vec
+    targ_selvecs="riscv_elf64_vec riscv_elf32_be_vec riscv_elf64_be_vec"
+    want64=true
+    ;;
   riscvbe-*-* | riscv32be*-*-*)
     targ_defvec=riscv_elf32_be_vec
     targ_selvecs="riscv_elf32_vec riscv_elf64_vec riscv_elf32_be_vec riscv_elf64_be_vec riscv64_pei_vec"
@@ -1356,6 +1371,11 @@
     targ_selvecs="i386_elf32_vec i386_coff_vec i386_pei_vec x86_64_pe_vec x86_64_pei_vec"
     want64=true
     ;;
+  x86_64-*-veridian*)
+    targ_defvec=x86_64_elf64_vec
+    targ_selvecs=i386_elf32_vec
+    want64=true
+    ;;
   x86_64-*-linux-*)
     targ_defvec=x86_64_elf64_vec
     targ_selvecs="i386_elf32_vec x86_64_elf32_vec i386_pei_vec x86_64_pe_vec x86_64_pei_vec"
diff --git a/gas/configure.tgt b/gas/configure.tgt
--- a/gas/configure.tgt
+++ b/gas/configure.tgt
@@ -138,6 +138,7 @@
   aarch64*-*-netbsd*)			fmt=elf em=nbsd;;
   aarch64*-*-nto*)			fmt=elf;;
   aarch64*-*-openbsd*)			fmt=elf;;
+  aarch64*-*-veridian*)			fmt=elf;;
   aarch64*-*-phoenix*)			fmt=elf;;
   aarch64*-*-pe* | aarch64*-*-mingw*)	fmt=coff em=pepaarch64 ;;
   alpha-*-*vms*)			fmt=evax ;;
@@ -266,6 +267,7 @@
   i386-*-nto-qnx*)			fmt=elf ;;
   i386-*-*nt*)				fmt=coff em=pe ;;
   i386-*-rdos*)				fmt=elf ;;
+  i386-*-veridian*)			fmt=elf ;;
   i386-*-darwin*)			fmt=macho ;;
   i386-*-phoenix*)			fmt=elf ;;
 
@@ -373,6 +375,7 @@
   pru-*-*)				fmt=elf ;;
 
   riscv*-*-haiku*)			fmt=elf endian=little em=haiku ;;
+  riscv*-*-veridian*)			fmt=elf ;;
   riscv*-*-*)				fmt=elf ;;
 
   rx-*-linux*)				fmt=elf em=linux ;;
diff --git a/ld/configure.tgt b/ld/configure.tgt
--- a/ld/configure.tgt
+++ b/ld/configure.tgt
@@ -96,6 +96,10 @@
 			targ_emul=aarch64elf
 			targ_extra_emuls="aarch64elfb armelf armelfb"
 			;;
+aarch64-*-veridian*)	targ_emul=aarch64elf
+			targ_extra_emuls="aarch64elfb aarch64elf32 aarch64elf32b"
+			targ_extra_libpath=$targ_extra_emuls
+			;;
 aarch64_be-*-linux-gnu_ilp32)
 			targ_emul=aarch64linux32b
 			targ_extra_libpath="aarch64linuxb aarch64linux aarch64linux32 armelfb_linux_eabi armelf_linux_eabi"
@@ -781,6 +785,10 @@
 			targ_emul=elf32lriscv
 			targ_extra_libpath="elf64lriscv elf32briscv elf64briscv"
 			;;
+riscv64-*-veridian*)	targ_emul=elf64lriscv
+			targ_extra_emuls="elf64lriscv_lp64f elf64lriscv_lp64 elf32lriscv"
+			targ_extra_libpath=$targ_extra_emuls
+			;;
 riscv64be*-*-linux*)	targ_emul=elf64briscv
 			targ_extra_libpath="elf64briscv_lp64f elf64briscv_lp64 elf32briscv elf32briscv_ilp32f elf32briscv_ilp32 elf64lriscv elf64lriscv_lp64f elf64lriscv_lp64 elf32lriscv elf32lriscv_ilp32f elf32lriscv_ilp32"
 			;;
@@ -969,6 +977,10 @@
 			targ_extra_libpath="elf_i386 elf32_x86_64"
 			tdir_elf_i386=`echo ${targ_alias} | sed -e 's/x86_64/i386/'`
 			;;
+x86_64-*-veridian*)	targ_emul=elf_x86_64
+			targ_extra_emuls="elf_i386"
+			targ_extra_libpath=$targ_extra_emuls
+			;;
 x86_64-*-dragonfly*)	targ_emul=elf_x86_64
 			targ_extra_emuls="elf_i386"
 			;;
