#!/usr/bin/env bash
# Pre-push hook for VeridianOS
# Runs tests before pushing to remote

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "Running pre-push checks..."

# Get remote and branch info
REMOTE="$1"
URL="$2"

# Check if pushing to main/develop (protected branches)
PROTECTED_BRANCHES=("main" "develop")
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

IS_PROTECTED=0
for branch in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$CURRENT_BRANCH" = "$branch" ]; then
        IS_PROTECTED=1
        break
    fi
done

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# 1. Check for WIP commits
echo "Checking for WIP commits..."
WIP_COMMITS=$(git log --oneline @{u}.. | grep -i "^[a-f0-9]* wip" || true)
if [ -n "$WIP_COMMITS" ]; then
    echo -e "${RED}WIP commits detected:${NC}"
    echo "$WIP_COMMITS"
    echo ""
    echo "Please squash or amend WIP commits before pushing"
    echo "Use 'git push --no-verify' to force push (not recommended)"
    exit 1
else
    echo -e "${GREEN}No WIP commits${NC}"
fi

# 2. Cargo.lock up to date (cargo metadata checks it without building; a
# plain `cargo check` builds the kernel's bare-metal binary for the host and
# fails for that reason, not the lockfile's)
echo "Checking Cargo.lock..."
if ! cargo metadata --locked --format-version 1 >/dev/null 2>&1; then
    echo -e "${RED}Cargo.lock is out of date${NC}"
    echo "Run 'cargo update -w' and commit the updated Cargo.lock"
    exit 1
else
    echo -e "${GREEN}Cargo.lock is up to date${NC}"
fi

# 3. Formatting, clippy on every target and the host tests: the gate
# without QEMU. Pushes to main or develop always run it; elsewhere
# RUN_TESTS_PREPUSH=0 skips it, and then only formatting is checked.
if [ $IS_PROTECTED -eq 1 ] || [ "${RUN_TESTS_PREPUSH:-1}" = "1" ]; then
    echo "Running scripts/dev/gate.sh (fmt, clippy, syscall checks, host tests)..."
    GATE_LOG=$(mktemp)
    trap 'rm -f "$GATE_LOG"' EXIT
    if scripts/dev/gate.sh >"$GATE_LOG" 2>&1; then
        rm -f "$GATE_LOG"
        echo -e "${GREEN}Gate passed${NC}"
    else
        tail -n 40 "$GATE_LOG"
        rm -f "$GATE_LOG"
        echo -e "${RED}Gate failed (the last lines are above)${NC}"
        if [ $IS_PROTECTED -eq 1 ]; then
            echo "Pushes to $CURRENT_BRANCH always run the gate; fix the failing step"
        else
            echo "Fix the failing step, or set RUN_TESTS_PREPUSH=0 to skip the gate"
        fi
        exit 1
    fi
else
    echo -e "${YELLOW}Gate skipped (RUN_TESTS_PREPUSH=${RUN_TESTS_PREPUSH}); checking formatting only${NC}"
    echo "Checking code formatting..."
    if command_exists rustfmt; then
        if ! cargo fmt --all -- --check >/dev/null 2>&1; then
            echo -e "${RED}Code formatting issues detected${NC}"
            echo "Run 'cargo fmt' to fix formatting"
            exit 1
        else
            echo -e "${GREEN}Code formatting OK${NC}"
        fi
    fi
fi

# 4. Check documentation builds
echo "Checking documentation..."
if ! cargo doc --lib --features alloc -p veridian-kernel --target x86_64-unknown-linux-gnu --no-deps --quiet 2>/dev/null; then
    echo -e "${YELLOW}Documentation build warnings${NC}"
fi

# 5. Security check for sensitive files
echo "Checking for sensitive files..."
SENSITIVE_PATTERNS=(
    "*.key"
    "*.pem"
    "*.p12"
    ".env*"
    "*_rsa"
    "*_dsa"
    "*_ed25519"
    "*_ecdsa"
    "*.pfx"
    "secrets.json"
    "credentials.json"
)

FOUND_SENSITIVE=0
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if git diff --name-only @{u}.. | grep -q "$pattern"; then
        echo -e "${RED}Potentially sensitive file detected: $pattern${NC}"
        FOUND_SENSITIVE=1
    fi
done

if [ $FOUND_SENSITIVE -eq 1 ]; then
    echo "Ensure no secrets are being committed"
    echo "Use 'git push --no-verify' to force push if intentional"
    exit 1
else
    echo -e "${GREEN}No sensitive files detected${NC}"
fi

# 6. Check branch naming
if [[ ! "$CURRENT_BRANCH" =~ ^(main|develop|feature/.*|bugfix/.*|hotfix/.*|release/.*|chore/.*)$ ]]; then
    echo -e "${YELLOW}Non-standard branch name: $CURRENT_BRANCH${NC}"
    echo "Consider using: feature/, bugfix/, hotfix/, release/, or chore/"
fi

# 7. Size check - warn about large pushes
COMMIT_COUNT=$(git rev-list --count @{u}..)
if [ "$COMMIT_COUNT" -gt 20 ]; then
    echo -e "${YELLOW}Large push detected ($COMMIT_COUNT commits)${NC}"
    echo "Consider breaking into smaller PRs"
fi

# Summary
echo ""
echo -e "${GREEN}Pre-push checks completed${NC}"
echo -e "  Remote: ${BLUE}$REMOTE${NC}"
echo -e "  Branch: ${BLUE}$CURRENT_BRANCH${NC}"
echo -e "  Commits: ${BLUE}$COMMIT_COUNT${NC}"
echo ""

exit 0