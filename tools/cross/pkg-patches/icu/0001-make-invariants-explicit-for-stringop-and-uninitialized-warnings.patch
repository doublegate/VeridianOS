@@ -1147,6 +1147,12 @@
                 pKey32 = reinterpret_cast<const int32_t*>(p);
                 qKey32 = reinterpret_cast<int32_t*>(q);
                 count=udata_readInt32(ds, *pKey32);
+                if(count<0) {
+                    udata_printError(ds, "ures_swapResource(table res=%08x): negative item count %d\n",
+                                     res, count);
+                    *pErrorCode=U_INVALID_FORMAT_ERROR;
+                    return;
+                }
 
                 pKey16=qKey16=nullptr;
 
diff -ru a/i18n/decNumber.cpp b/i18n/decNumber.cpp
--- a/i18n/decNumber.cpp	2026-10-08 17:22:40.622234962 -0400
+++ b/i18n/decNumber.cpp	2026-10-08 17:26:15.397657009 -0400
@@ -2958,39 +2958,23 @@
 
     /* Calculate initial approximation, and allow for odd exponent  */
     workset.digits=workp;                    /* p for initial calculation  */
-    t->bits=0; t->digits=3;
-    a->bits=0; a->digits=3;
+    /* [The three-digit coefficients are laid out by decNumberFromUInt32,  */
+    /* which handles any DECDPUN; t is a 3-digit buffer (buft).]  */
     if ((exp & 1)==0) {                      /* even exponent  */
       /* Set t=0.259, a=0.819  */
+      uprv_decNumberFromUInt32(t, 259);
+      uprv_decNumberFromUInt32(a, 819);
       t->exponent=-3;
       a->exponent=-3;
-      #if DECDPUN>=3
-        t->lsu[0]=259;
-        a->lsu[0]=819;
-      #elif DECDPUN==2
-        t->lsu[0]=59; t->lsu[1]=2;
-        a->lsu[0]=19; a->lsu[1]=8;
-      #else
-        t->lsu[0]=9; t->lsu[1]=5; t->lsu[2]=2;
-        a->lsu[0]=9; a->lsu[1]=1; a->lsu[2]=8;
-      #endif
       }
      else {                                  /* odd exponent  */
       /* Set t=0.0819, a=2.59  */
       f->exponent--;                         /* f=f/10  */
       exp++;                                 /* e=e+1  */
+      uprv_decNumberFromUInt32(t, 819);
+      uprv_decNumberFromUInt32(a, 259);
       t->exponent=-4;
       a->exponent=-2;
-      #if DECDPUN>=3
-        t->lsu[0]=819;
-        a->lsu[0]=259;
-      #elif DECDPUN==2
-        t->lsu[0]=19; t->lsu[1]=8;
-        a->lsu[0]=59; a->lsu[1]=2;
-      #else
-        t->lsu[0]=9; t->lsu[1]=1; t->lsu[2]=8;
-        a->lsu[0]=9; a->lsu[1]=5; a->lsu[2]=2;
-      #endif
       }
 
     decMultiplyOp(a, a, f, &workset, &ignore);    /* a=a*f  */
