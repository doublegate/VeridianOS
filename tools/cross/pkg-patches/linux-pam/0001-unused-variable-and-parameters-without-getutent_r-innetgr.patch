-evaluate_innetgr(const pam_handle_t* pamh SOMETIMES_UNUSED, const char *host, const char *user, const char *group)
+evaluate_innetgr(const pam_handle_t* pamh SOMETIMES_UNUSED,
+		 const char *host UNUSED_WITHOUT_INNETGR,
+		 const char *user UNUSED_WITHOUT_INNETGR,
+		 const char *group UNUSED_WITHOUT_INNETGR)
 {
 #ifdef HAVE_INNETGR
 	if (innetgr(group, host, user, NULL) == 1)
