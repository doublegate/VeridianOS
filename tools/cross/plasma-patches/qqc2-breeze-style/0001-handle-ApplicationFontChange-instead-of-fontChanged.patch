@@ -58,6 +58,9 @@
     void grooveThicknessChanged();
     void notchesVisibleChanged();
 
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
 private:
     const std::unique_ptr<BreezeDialPrivate> d_ptr;
     Q_DECLARE_PRIVATE(BreezeDial)
