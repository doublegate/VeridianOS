VeridianOS: fix compiler warnings in the screen locker

GCC reported:

- -Wmissing-field-initializers for org_kde_ksld_interface::suspendSystem
  and ::hibernateSystem in WaylandServer's bind function
  (waylandserver.cpp): the designated initializer named only x11window. Both
  are version 3 requests and the global is bound at qMin(version, 1u), so
  libwayland-server rejects them ("invalid version") before dispatch. They
  are now named explicitly as nullptr with that explanation; the struct was
  already zero-filled. Behaviour is unchanged.
- -Wdeprecated-declarations for LayerShellQt::Shell::useLayerShell() in
  main() (greeter/main.cpp): "Calling useLayerShell is not needed since Qt
  6.5". The call only set QT_WAYLAND_SHELL_INTEGRATION=layer-shell for the
  whole process. Since Qt 6.5, LayerShellQt::Window::get() installs the
  layer-shell integration per window, and UnlockApp::createViewForScreen()
  (greeterapp.cpp) calls it for every lock screen view before showing it,
  so the views remain layer-shell surfaces. The call and its include are
  removed.

diff -ru a/greeter/main.cpp b/greeter/main.cpp
--- a/greeter/main.cpp	2026-10-08 17:22:23.552009853 -0400
+++ b/greeter/main.cpp	2026-10-08 17:22:33.415287833 -0400
@@ -28,7 +28,6 @@
 #endif
 
 #include <KSignalHandler>
-#include <LayerShellQt/Shell>
 
 static void signalHandler(int signum)
 {
@@ -64,8 +63,6 @@
     sigaddset(&blockedSignals, SIGUSR1);
     pthread_sigmask(SIG_BLOCK, &blockedSignals, NULL);
 
-    LayerShellQt::Shell::useLayerShell();
-
     // disable ptrace on the greeter
 #if HAVE_PR_SET_DUMPABLE
     prctl(PR_SET_DUMPABLE, 0);
diff -ru a/waylandserver.cpp b/waylandserver.cpp
--- a/waylandserver.cpp	2026-10-08 17:22:23.548530112 -0400
+++ b/waylandserver.cpp	2026-10-08 17:22:35.252274357 -0400
@@ -139,6 +139,10 @@
                     Q_EMIT s->x11WindowAdded(id);
                 }
             },
+        // version 3 requests; the global is bound at version 1 at most, so
+        // libwayland rejects them before they reach an implementation
+        .suspendSystem = nullptr,
+        .hibernateSystem = nullptr,
     };
 
     wl_resource_set_implementation(resource, &s_interface, server, nullptr);
