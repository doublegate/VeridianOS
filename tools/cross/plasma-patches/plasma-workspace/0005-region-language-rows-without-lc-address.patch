     switch (static_cast<Roles>(role)) {
     case Name:
         return m_staticNames.at(row).first;
     case Subtitle: {
-        switch (static_cast<SettingType>(row)) {
+        switch (settingType) {
         case Language:
             Q_ASSERT(false); // shouldn't happen
             return {};
@@ -168,6 +171,12 @@
                 return getNativeName(m_settings->phoneNumbers());
             }
             break;
+#else
+        case Address:
+        case NameStyle:
+        case PhoneNumbers:
+            // Not in m_staticNames without LC_ADDRESS, so never a row here.
+            break;
 #endif
         case BinaryDialect:
             Q_UNREACHABLE();
@@ -175,7 +184,7 @@
         return {}; // implicit locale
     }
     case Example: {
-        switch (static_cast<SettingType>(row)) {
+        switch (settingType) {
         case Language:
             Q_ASSERT(false); // shouldn't happen
             return {};
@@ -238,6 +247,12 @@
             }
             return example;
         }
+#else
+        case Address:
+        case NameStyle:
+        case PhoneNumbers:
+            // Not in m_staticNames without LC_ADDRESS, so never a row here.
+            break;
 #endif
         case BinaryDialect:
             return m_binaryDialectExample;
@@ -300,7 +315,9 @@
     m_binaryDialect = static_cast<KFormat::BinaryUnitDialect>(i);
