 #include <QFileInfo>
 #include <QHBoxLayout>
 #include <QLabel>
@@ -107,8 +108,15 @@ void ConfigurationModule::initQml()
     QUiLoader *loader = new QUiLoader(this);
     loader->setLanguageChangeEnabled(true);
     QFile uiFile(ui);
-    uiFile.open(QFile::ReadOnly);
+    if (!uiFile.open(QFile::ReadOnly)) {
+        qWarning() << "Failed to open" << ui << uiFile.errorString();
+        return;
+    }
     QWidget *customConfigForm = loader->load(&uiFile, widget());
+    if (!customConfigForm) {
+        qWarning() << "Failed to load" << ui << loader->errorString();
+        return;
+    }
     translator->addContextToMonitor(customConfigForm->objectName());
     uiFile.close();
     widget()->setLayout(new QVBoxLayout);
