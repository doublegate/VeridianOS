-libdep_la_LDFLAGS = -no-undefined -rpath /nowhere -module -avoid-version
+libdep_la_LDFLAGS = -no-undefined -module -avoid-version
 libdep_la_LINK = $(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) \
 	--tag=disable-static \
 	$(LIBTOOLFLAGS) --mode=link $(CCLD) $(AM_CFLAGS) $(CFLAGS) \
--- a/libsframe/Makefile.am
+++ b/libsframe/Makefile.am
@@ -29,7 +29,11 @@
 # include libctf for swap.h
 AM_CPPFLAGS = -I$(srcdir)/../include -I$(srcdir)/../libctf
 AM_CFLAGS = @ac_libsframe_warn_cflags@
+# A library version only for the installed library: libtool ignores it, with
+# a warning, for the convenience library built otherwise.
+if INSTALL_LIBBFD
 libsframe_version_info = -version-info `grep -v '^\#' $(srcdir)/libtool-version`
+endif
 # libsframe does not restrict the set of exported symbols.  So, if linker does
 # not support symbol versioning, there is no need to fall back on libtool's
 # -export-symbols option.
