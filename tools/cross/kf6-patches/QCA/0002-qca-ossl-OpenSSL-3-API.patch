+// An EVP_PKEY whose private-key operations are performed by key, an RSA key of another QCA
+// provider. Returns nullptr if the key is not usable that way.
+static EVP_PKEY *createFromExisting(const RSAPrivateKey &key)
+{
+    if (key.isNull() || !keystore::loadProvider())
+        return nullptr;
+
+    const quint64 ticket   = keystore::addPending(key);
+    uint64_t      ticketId = ticket;
+    OSSL_PARAM params[] = {OSSL_PARAM_construct_uint64(keystore::kTicketParam, &ticketId), OSSL_PARAM_construct_end()};
+
+    EVP_PKEY     *pkey = nullptr;
+    EvpPkeyCtxPtr ctx(EVP_PKEY_CTX_new_from_name(nullptr, "RSA", keystore::kPropQuery));
+    if (!ctx || EVP_PKEY_fromdata_init(ctx.get()) <= 0 ||
+        EVP_PKEY_fromdata(ctx.get(), &pkey, EVP_PKEY_KEYPAIR, params) <= 0)
+        pkey = nullptr;
+
+    keystore::takePending(ticket); // in case the key manager did not take it
+    return pkey;
 }
 
