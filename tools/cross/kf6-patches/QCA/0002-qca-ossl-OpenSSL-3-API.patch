+// The groups come out as specified, and keys generated in them sign and verify, also the 512
+// and 768-bit ones that OpenSSL 3 only generates keys for by the FIPS 186-2 rules.
+void DSAUnitTest::testGroups()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!QCA::isSupported("pkey", provider) || !QCA::PKey::supportedTypes(provider).contains(QCA::PKey::DSA))
+        QSKIP("DSA not supported!");
+
+    QFETCH(QCA::DLGroupSet, set);
+    QFETCH(int, bits);
+    QFETCH(QString, p);
+    QFETCH(QString, q);
+    QFETCH(QString, g);
+
+    if (!QCA::DLGroup::supportedGroupSets(provider).contains(set))
+        QSKIP("group set not supported");
+
+    QCA::KeyGenerator keygen;
+    QCA::DLGroup      group = keygen.createDLGroup(set, provider);
+    QVERIFY(!group.isNull());
+    if (bits == 1024) {
+        QCOMPARE(hexOf(group.p()), p);
+        QCOMPARE(hexOf(group.q()), q);
+        QCOMPARE(hexOf(group.g()), g);
+    } else {
+        QCOMPARE(sha1Of(group.p()), p);
+        QCOMPARE(sha1Of(group.q()), q);
+        QCOMPARE(sha1Of(group.g()), g);
+    }
+
+    QCA::DSAPrivateKey key = keygen.createDSA(group, provider).toDSA();
+    QVERIFY(!key.isNull());
+    QCOMPARE(key.bitSize(), bits);
+    QCOMPARE(key.domain().p(), group.p());
+    QCOMPARE(key.domain().q(), group.q());
+    QCOMPARE(key.domain().g(), group.g());
+
+    const QCA::SecureArray message("DSA group test");
+    QCA::DSAPublicKey      pub = key.toPublicKey().toDSA();
+    const QByteArray       sig = key.signMessage(message, QCA::EMSA1_SHA1);
+    QCOMPARE(sig.size(), 40); // IEEE 1363: r and s, 20 bytes each
+    QVERIFY(pub.verifyMessage(message, sig, QCA::EMSA1_SHA1));
+    QVERIFY(!pub.verifyMessage(QCA::SecureArray("another message"), sig, QCA::EMSA1_SHA1));
+}
+
+// Keys built from their components work like the generated key they came from
+void DSAUnitTest::testImportExport()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!QCA::isSupported("pkey", provider) || !QCA::PKey::supportedTypes(provider).contains(QCA::PKey::DSA))
+        QSKIP("DSA not supported!");
+    if (!QCA::DLGroup::supportedGroupSets(provider).contains(QCA::DSA_1024))
+        QSKIP("DSA_1024 discrete logarithm group sets not supported!");
+
+    QCA::KeyGenerator  keygen;
+    QCA::DLGroup       group = keygen.createDLGroup(QCA::DSA_1024, provider);
+    QCA::DSAPrivateKey orig  = keygen.createDSA(group, provider).toDSA();
+    QVERIFY(!orig.isNull());
+    QCA::DSAPublicKey origPub = orig.toPublicKey().toDSA();
+
+    const QCA::DLGroup    domain = orig.domain();
+    const QCA::BigInteger y = orig.y(), x = orig.x();
+    QCOMPARE(origPub.y(), y);
+    QCOMPARE(origPub.domain().p(), group.p());
+    QCOMPARE(origPub.domain().q(), group.q());
+    QCOMPARE(origPub.domain().g(), group.g());
+
+    QCA::DSAPrivateKey imported(domain, y, x, provider);
+    QVERIFY(!imported.isNull());
+    QVERIFY(imported.isPrivate());
+    QCOMPARE(imported.bitSize(), 1024);
+    QCOMPARE(imported.y(), y);
+    QCOMPARE(imported.x(), x);
+    QCOMPARE(imported.domain().p(), group.p());
+    QCOMPARE(imported.domain().q(), group.q());
+    QCOMPARE(imported.domain().g(), group.g());
+
+    const QCA::SecureArray message("import and export");
+    const QByteArray       sig = imported.signMessage(message, QCA::EMSA1_SHA1);
+    QVERIFY(origPub.verifyMessage(message, sig, QCA::EMSA1_SHA1));
+    const QByteArray derSig = imported.signMessage(message, QCA::EMSA1_SHA1, QCA::DERSequence);
+    QVERIFY(origPub.verifyMessage(message, derSig, QCA::EMSA1_SHA1, QCA::DERSequence));
+
+    QCA::DSAPublicKey pubFromComponents(domain, y, provider);
+    QVERIFY(!pubFromComponents.isNull());
+    QVERIFY(pubFromComponents.isPublic());
+    QCOMPARE(pubFromComponents.y(), y);
+    QVERIFY(pubFromComponents.verifyMessage(message, orig.signMessage(message, QCA::EMSA1_SHA1), QCA::EMSA1_SHA1));
+    QCOMPARE(pubFromComponents.toDER(), origPub.toDER());
+
+    // the public half keeps p, q and g with y
+    QCA::DSAPublicKey converted = imported.toPublicKey().toDSA();
+    QVERIFY(!converted.isNull());
+    QVERIFY(converted.isPublic());
+    QVERIFY(!converted.isPrivate());
+    QCOMPARE(converted.y(), y);
+    QCOMPARE(converted.domain().p(), group.p());
+    QCOMPARE(converted.domain().q(), group.q());
+    QCOMPARE(converted.domain().g(), group.g());
+    QVERIFY(converted.verifyMessage(message, sig, QCA::EMSA1_SHA1));
+    QCOMPARE(converted.toDER(), origPub.toDER());
+}
+
 QTEST_MAIN(DSAUnitTest)
 
