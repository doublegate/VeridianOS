+// DH keys built from their components agree with the generated keys they came from
+void KeyGenUnitTest::testDHImportExport()
+{
+    QCA::KeyGenerator keygen;
+
+    if (!QCA::isSupported("pkey") || !QCA::PKey::supportedTypes().contains(QCA::PKey::DH))
+        QSKIP("DH not supported!");
+
+    const QList<QCA::DLGroupSet> sets = {QCA::IETF_1024, QCA::IETF_2048};
+    for (QCA::DLGroupSet set : sets) {
+        const QCA::DLGroup group = keygen.createDLGroup(set);
+        QCOMPARE(group.isNull(), false);
+        QCOMPARE(group.q(), QCA::BigInteger(0)); // DH groups are (p, g)
+
+        QCA::DHPrivateKey a = keygen.createDH(group).toDH();
+        QCA::DHPrivateKey b = keygen.createDH(group).toDH();
+        QCOMPARE(a.isNull(), false);
+        QCOMPARE(b.isNull(), false);
+        QCOMPARE(a.domain().p(), group.p());
+        QCOMPARE(a.domain().g(), group.g());
+
+        QCA::DHPrivateKey imported(a.domain(), a.y(), a.x());
+        QCOMPARE(imported.isNull(), false);
+        QVERIFY(imported.isPrivate());
+        QCOMPARE(imported.bitSize(), a.bitSize());
+        QCOMPARE(imported.x(), a.x());
+        QCOMPARE(imported.y(), a.y());
+        QCOMPARE(imported.domain().p(), group.p());
+        QCOMPARE(imported.domain().g(), group.g());
+
+        QCA::DHPublicKey bPub(b.domain(), b.y());
+        QCOMPARE(bPub.isNull(), false);
+        QVERIFY(bPub.isPublic());
+        QCOMPARE(bPub.y(), b.y());
+
+        const QCA::SymmetricKey shared = imported.deriveKey(bPub);
+        QCOMPARE(shared.isEmpty(), false);
+        QCOMPARE(shared, a.deriveKey(b.toPublicKey()));
+        QCOMPARE(shared, b.deriveKey(imported.toPublicKey()));
+
+        // the public half keeps the domain and y
+        QCA::DHPublicKey converted = imported.toPublicKey().toDH();
+        QCOMPARE(converted.isNull(), false);
+        QVERIFY(converted.isPublic());
+        QCOMPARE(converted.y(), a.y());
+        QCOMPARE(converted.domain().p(), group.p());
+        QCOMPARE(converted.domain().g(), group.g());
+        QCOMPARE(b.deriveKey(converted), shared);
+    }
+}
+
+// The shared secret is the plain DH value, without leading zero bytes (DH_compute_key(), not
+// the padded variant): about one secret in 256 is shorter than p.
+void KeyGenUnitTest::testDHSharedSecretLength()
+{
+    QCA::KeyGenerator keygen;
+
+    if (!QCA::isSupported("pkey") || !QCA::PKey::supportedTypes().contains(QCA::PKey::DH))
+        QSKIP("DH not supported!");
+
+    const QCA::DLGroup group = keygen.createDLGroup(QCA::IETF_1024);
+    QCOMPARE(group.isNull(), false);
+    const int pBytes = 128;
+
+    QCA::PrivateKey a = keygen.createDH(group);
+    QCOMPARE(a.isNull(), false);
+    const QCA::PublicKey aPub = a.toPublicKey();
+
+    bool sawShort = false;
+    for (int i = 0; i < 4000 && !sawShort; ++i) {
+        QCA::PrivateKey b = keygen.createDH(group);
+        QCOMPARE(b.isNull(), false);
+        const QCA::SymmetricKey shared = a.deriveKey(b.toPublicKey());
+        QVERIFY(!shared.isEmpty());
+        QVERIFY(shared.size() <= pBytes);
+        QVERIFY(shared[0] != 0); // never zero-padded
+        if (shared.size() < pBytes) {
+            sawShort = true;
+            QCOMPARE(b.deriveKey(aPub), shared);
+        }
+    }
+    QVERIFY(sawShort);
+}
+
 QTEST_MAIN(KeyGenUnitTest)
 
