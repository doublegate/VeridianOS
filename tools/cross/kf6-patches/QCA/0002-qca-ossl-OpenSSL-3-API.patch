+// qca-ossl with a private key that belongs to another QCA provider, as a smart card or PKCS#11
+// key reached through a keystore does: TLS (server and client authentication, RSA key exchange)
+// and CMS (signing, decryption) must hand every private-key operation to that provider.
+
+#include <QTest>
+#include <QtCrypto>
+#include <qcaprovider.h>
+
+#include <openssl/err.h>
+#include <openssl/ssl.h>
+
+#include <atomic>
+
+#ifdef QT_STATICPLUGIN
+#include "import_plugins.h"
+#endif
+
+namespace {
+
+struct Counters
+{
+    std::atomic<int> sign {0};
+    std::atomic<int> decrypt {0};
+
+    void reset()
+    {
+        sign    = 0;
+        decrypt = 0;
+    }
+};
+
+// Stands in for a keystore provider. Its keys are never handed to OpenSSL.
+class KeystoreProvider : public QCA::Provider
+{
+public:
+    int qcaVersion() const override
+    {
+        return QCA_VERSION;
+    }
+
+    QString name() const override
+    {
+        return QStringLiteral("keystore-test");
+    }
+
+    QStringList features() const override
+    {
+        return QStringList();
+    }
+
+    Provider::Context *createContext(const QString &) override
+    {
+        return nullptr;
+    }
+};
+
+// An RSA key of the keystore: only n and e are known outside; signing and decryption are done
+// here (by an ordinary qca-ossl key standing in for the token) and counted.
+class KeystoreRSAContext : public QCA::RSAContext
+{
+    Q_OBJECT
+public:
+    KeystoreRSAContext(QCA::Provider *p, const QCA::RSAPrivateKey &inner, Counters *counters)
+        : QCA::RSAContext(p)
+        , m_inner(inner)
+        , m_counters(counters)
+    {
+    }
+
+    KeystoreRSAContext(const KeystoreRSAContext &from)
+        : QCA::RSAContext(from.provider())
+        , m_inner(from.m_inner)
+        , m_counters(from.m_counters)
+    {
+    }
+
+    QCA::Provider::Context *clone() const override
+    {
+        return new KeystoreRSAContext(*this);
+    }
+
+    bool isNull() const override
+    {
+        return m_inner.isNull();
+    }
+
+    QCA::PKey::Type type() const override
+    {
+        return QCA::PKey::RSA;
+    }
+
+    bool isPrivate() const override
+    {
+        return true;
+    }
+
+    bool canExport() const override
+    {
+        return false;
+    }
+
+    void convertToPublic() override
+    {
+    }
+
+    int bits() const override
+    {
+        return m_inner.bitSize();
+    }
+
+    int maximumEncryptSize(QCA::EncryptionAlgorithm alg) const override
+    {
+        return m_inner.maximumEncryptSize(alg);
+    }
+
+    bool decrypt(const QCA::SecureArray &in, QCA::SecureArray *out, QCA::EncryptionAlgorithm alg) override
+    {
+        ++m_counters->decrypt;
+        return m_inner.decrypt(in, out, alg);
+    }
+
+    void startSign(QCA::SignatureAlgorithm alg, QCA::SignatureFormat format) override
+    {
+        m_alg    = alg;
+        m_format = format;
+        m_data.clear();
+    }
+
+    void update(const QCA::MemoryRegion &in) override
+    {
+        m_data += in.toByteArray();
+    }
+
+    QByteArray endSign() override
+    {
+        ++m_counters->sign;
+        return m_inner.signMessage(m_data, m_alg, m_format);
+    }
+
+    void createPrivate(int, int, bool) override
+    {
+    }
+
+    void createPrivate(const QCA::BigInteger &,
+                       const QCA::BigInteger &,
+                       const QCA::BigInteger &,
+                       const QCA::BigInteger &,
+                       const QCA::BigInteger &) override
+    {
+    }
+
+    void createPublic(const QCA::BigInteger &, const QCA::BigInteger &) override
+    {
+    }
+
+    QCA::BigInteger n() const override
+    {
+        return m_inner.n();
+    }
+
+    QCA::BigInteger e() const override
+    {
+        return m_inner.e();
+    }
+
+    // the private components stay in the keystore
+    QCA::BigInteger p() const override
+    {
+        return QCA::BigInteger();
+    }
+
+    QCA::BigInteger q() const override
+    {
+        return QCA::BigInteger();
+    }
+
+    QCA::BigInteger d() const override
+    {
+        return QCA::BigInteger();
+    }
+
+private:
+    QCA::RSAPrivateKey      m_inner;
+    Counters               *m_counters;
+    QCA::SignatureAlgorithm m_alg    = QCA::SignatureUnknown;
+    QCA::SignatureFormat    m_format = QCA::DefaultFormat;
+    QByteArray              m_data;
+};
+
+class KeystorePKeyContext : public QCA::PKeyContext
+{
+    Q_OBJECT
+public:
+    KeystorePKeyContext(QCA::Provider *p)
+        : QCA::PKeyContext(p)
+    {
+    }
+
+    ~KeystorePKeyContext() override
+    {
+        delete m_key;
+    }
+
+    QCA::Provider::Context *clone() const override
+    {
+        KeystorePKeyContext *c = new KeystorePKeyContext(provider());
+        c->m_key               = m_key ? static_cast<QCA::PKeyBase *>(m_key->clone()) : nullptr;
+        return c;
+    }
+
+    QList<QCA::PKey::Type> supportedTypes() const override
+    {
+        return QList<QCA::PKey::Type>() << QCA::PKey::RSA;
+    }
+
+    QList<QCA::PKey::Type> supportedIOTypes() const override
+    {
+        return QList<QCA::PKey::Type>();
+    }
+
+    QList<QCA::PBEAlgorithm> supportedPBEAlgorithms() const override
+    {
+        return QList<QCA::PBEAlgorithm>();
+    }
+
+    QCA::PKeyBase *key() override
+    {
+        return m_key;
+    }
+
+    const QCA::PKeyBase *key() const override
+    {
+        return m_key;
+    }
+
+    void setKey(QCA::PKeyBase *key) override
+    {
+        delete m_key;
+        m_key = key;
+    }
+
+    bool importKey(const QCA::PKeyBase *) override
+    {
+        return false;
+    }
+
+private:
+    QCA::PKeyBase *m_key = nullptr;
+};
+
+} // namespace
+
+class KeystoreKeyUnitTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void cleanupTestCase();
+    void tlsServerSignature();
+    void tlsClientSignature();
+    void tlsRsaKeyExchange();
+    void tlsKeyNotMatchingCertificate();
+    void cmsSign();
+    void cmsDecrypt();
+    void pluginReload();
+
+private:
+    void            createIdentity();
+    QCA::PrivateKey keystoreKey(const QCA::RSAPrivateKey &inner);
+    bool            handshake(QCA::TLS &client, QCA::TLS &server);
+    void            transfer(QCA::TLS &from, QCA::TLS &to);
+
+    QCA::Initializer          *m_init = nullptr;
+    KeystoreProvider           m_provider;
+    Counters                   m_counters;
+    QCA::RSAPrivateKey         m_key;
+    QCA::Certificate           m_cert;
+    QCA::CertificateCollection m_trusted;
+    bool                       m_supported = false;
+};
+
+static const QString kOssl = QStringLiteral("qca-ossl");
+
+void KeystoreKeyUnitTest::initTestCase()
+{
+    m_init      = new QCA::Initializer;
+    m_supported = QCA::isSupported("pkey", kOssl) && QCA::isSupported("cert", kOssl) &&
+        QCA::isSupported("tls", kOssl) && QCA::isSupported("cms", kOssl);
+    if (m_supported)
+        createIdentity();
+}
+
+void KeystoreKeyUnitTest::cleanupTestCase()
+{
+    m_trusted = QCA::CertificateCollection();
+    m_cert    = QCA::Certificate();
+    m_key     = QCA::RSAPrivateKey();
+    delete m_init;
+}
+
+// A self-signed certificate for a fresh RSA key, trusted by both ends
+void KeystoreKeyUnitTest::createIdentity()
+{
+    m_key = QCA::KeyGenerator().createRSA(2048, 65537, kOssl).toRSA();
+    QVERIFY(!m_key.isNull());
+
+    QCA::CertificateOptions opts;
+    QCA::CertificateInfo    info;
+    info.insert(QCA::CommonName, QStringLiteral("keystore.test"));
+    opts.setInfo(info);
+    QCA::Constraints constraints;
+    constraints << QCA::ConstraintType(QCA::DigitalSignature) << QCA::ConstraintType(QCA::KeyEncipherment)
+                << QCA::ConstraintType(QCA::ServerAuth) << QCA::ConstraintType(QCA::ClientAuth)
+                << QCA::ConstraintType(QCA::EmailProtection);
+    opts.setConstraints(constraints);
+    opts.setSerialNumber(QCA::BigInteger(1));
+    const QDateTime now = QDateTime::currentDateTimeUtc();
+    opts.setValidityPeriod(now.addDays(-1), now.addDays(1));
+
+    m_cert = QCA::Certificate(opts, m_key, kOssl);
+    QVERIFY(!m_cert.isNull());
+    m_trusted = QCA::CertificateCollection();
+    m_trusted.addCertificate(m_cert);
+}
+
+// A private key of the keystore provider that does its operations with inner
+QCA::PrivateKey KeystoreKeyUnitTest::keystoreKey(const QCA::RSAPrivateKey &inner)
+{
+    KeystorePKeyContext *ctx = new KeystorePKeyContext(&m_provider);
+    ctx->setKey(new KeystoreRSAContext(&m_provider, inner, &m_counters));
+    QCA::PrivateKey key;
+    key.change(ctx);
+    return key;
+}
+
+void KeystoreKeyUnitTest::transfer(QCA::TLS &from, QCA::TLS &to)
+{
+    const QByteArray data = from.readOutgoing();
+    if (!data.isEmpty())
+        to.writeIncoming(data);
+}
+
+bool KeystoreKeyUnitTest::handshake(QCA::TLS &client, QCA::TLS &server)
+{
+    for (int i = 0; i < 500 && !(client.isHandshaken() && server.isHandshaken()); ++i) {
+        transfer(client, server);
+        transfer(server, client);
+        QTest::qWait(1);
+    }
+    return client.isHandshaken() && server.isHandshaken();
+}
+
+// The server authenticates with a keystore key: it signs its (EC)DHE key exchange through it.
+void KeystoreKeyUnitTest::tlsServerSignature()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::TLS server(nullptr, kOssl);
+    server.setCertificate(QCA::CertificateChain(m_cert), keystoreKey(m_key));
+    server.startServer();
+
+    QCA::TLS client(nullptr, kOssl);
+    client.setTrustedCertificates(m_trusted);
+    client.startClient(QStringLiteral("keystore.test"));
+
+    QVERIFY(handshake(client, server));
+    QVERIFY(m_counters.sign > 0);
+    QCOMPARE(m_counters.decrypt.load(), 0);
+    QCOMPARE(client.peerCertificateChain().primary(), m_cert);
+
+    client.write("from the client");
+    server.write("from the server");
+    for (int i = 0; i < 20; ++i) {
+        transfer(client, server);
+        transfer(server, client);
+        QTest::qWait(1);
+    }
+    QCOMPARE(server.read(), QByteArray("from the client"));
+    QCOMPARE(client.read(), QByteArray("from the server"));
+}
+
+// The client authenticates with a keystore key: it signs its CertificateVerify through it.
+void KeystoreKeyUnitTest::tlsClientSignature()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::TLS server(nullptr, kOssl);
+    server.setCertificate(QCA::CertificateChain(m_cert), m_key);
+    server.setTrustedCertificates(m_trusted);
+    server.startServer();
+
+    QCA::TLS client(nullptr, kOssl);
+    client.setCertificate(QCA::CertificateChain(m_cert), keystoreKey(m_key));
+    client.setTrustedCertificates(m_trusted);
+    client.startClient(QStringLiteral("keystore.test"));
+
+    QVERIFY(handshake(client, server));
+    QVERIFY(m_counters.sign > 0);
+    QCOMPARE(server.peerCertificateChain().primary(), m_cert);
+    QCOMPARE(server.peerCertificateValidity(), QCA::ValidityGood);
+
+    client.write("authenticated");
+    for (int i = 0; i < 20; ++i) {
+        transfer(client, server);
+        transfer(server, client);
+        QTest::qWait(1);
+    }
+    QCOMPARE(server.read(), QByteArray("authenticated"));
+}
+
+// RSA key exchange: the server decrypts the premaster secret through the keystore key. The
+// client is plain OpenSSL, restricted to an RSA key exchange cipher suite.
+void KeystoreKeyUnitTest::tlsRsaKeyExchange()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::TLS server(nullptr, kOssl);
+    server.setCertificate(QCA::CertificateChain(m_cert), keystoreKey(m_key));
+    server.startServer();
+
+    SSL_CTX *ctx = SSL_CTX_new(TLS_client_method());
+    QVERIFY(ctx);
+    QVERIFY(SSL_CTX_set_max_proto_version(ctx, TLS1_2_VERSION) == 1);
+    QVERIFY(SSL_CTX_set_cipher_list(ctx, "AES128-GCM-SHA256") == 1);
+    SSL *ssl = SSL_new(ctx);
+    QVERIFY(ssl);
+    BIO *toClient   = BIO_new(BIO_s_mem());
+    BIO *fromClient = BIO_new(BIO_s_mem());
+    SSL_set_bio(ssl, toClient, fromClient);
+    SSL_set_connect_state(ssl);
+
+    auto pump = [&]() {
+        QByteArray buf(16384, 0);
+        int        n;
+        while ((n = BIO_read(fromClient, buf.data(), buf.size())) > 0)
+            server.writeIncoming(buf.left(n));
+        const QByteArray reply = server.readOutgoing();
+        if (!reply.isEmpty())
+            BIO_write(toClient, reply.constData(), reply.size());
+        QTest::qWait(1);
+    };
+
+    for (int i = 0; i < 500 && !(SSL_is_init_finished(ssl) && server.isHandshaken()); ++i) {
+        SSL_do_handshake(ssl);
+        pump();
+    }
+    QVERIFY(SSL_is_init_finished(ssl));
+    QVERIFY(server.isHandshaken());
+    QCOMPARE(QByteArray(SSL_CIPHER_get_name(SSL_get_current_cipher(ssl))), QByteArray("AES128-GCM-SHA256"));
+    QVERIFY(m_counters.decrypt > 0);
+    QCOMPARE(m_counters.sign.load(), 0);
+
+    // the keys agree: data goes through both ways
+    QCOMPARE(SSL_write(ssl, "ping", 4), 4);
+    server.write("pong");
+    QByteArray received;
+    char       buf[16];
+    for (int i = 0; i < 20 && received.isEmpty(); ++i) {
+        pump();
+        const int n = SSL_read(ssl, buf, sizeof(buf));
+        if (n > 0)
+            received = QByteArray(buf, n);
+    }
+    QCOMPARE(received, QByteArray("pong"));
+    QCOMPARE(server.read(), QByteArray("ping"));
+
+    SSL_free(ssl);
+    SSL_CTX_free(ctx);
+}
+
+// A keystore key that is not the certificate's key is refused when the session starts.
+void KeystoreKeyUnitTest::tlsKeyNotMatchingCertificate()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::RSAPrivateKey other = QCA::KeyGenerator().createRSA(2048, 65537, kOssl).toRSA();
+    QVERIFY(!other.isNull());
+
+    QCA::TLS server(nullptr, kOssl);
+    server.setCertificate(QCA::CertificateChain(m_cert), keystoreKey(other));
+    server.startServer();
+    for (int i = 0; i < 10; ++i)
+        QTest::qWait(1);
+    QCOMPARE(server.errorCode(), QCA::TLS::ErrorInit);
+
+    QCA::TLS client(nullptr, kOssl);
+    client.setTrustedCertificates(m_trusted);
+    client.startClient(QStringLiteral("keystore.test"));
+
+    QVERIFY(!handshake(client, server));
+    QCOMPARE(m_counters.sign.load(), 0);
+    QCOMPARE(m_counters.decrypt.load(), 0);
+}
+
+// CMS signature by a keystore key, verified with the certificate
+void KeystoreKeyUnitTest::cmsSign()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::SecureMessageKey signer;
+    signer.setX509CertificateChain(QCA::CertificateChain(m_cert));
+    signer.setX509PrivateKey(keystoreKey(m_key));
+
+    const QByteArray   text("signed with a keystore key");
+    QCA::CMS           cms(nullptr, kOssl);
+    QCA::SecureMessage msg(&cms);
+    msg.setSigner(signer);
+    msg.startSign(QCA::SecureMessage::Message);
+    msg.update(text);
+    msg.end();
+    msg.waitForFinished(-1);
+    const QByteArray signedText = msg.read();
+    QVERIFY(!signedText.isEmpty());
+    QVERIFY(m_counters.sign > 0);
+
+    QCA::CMS verifier(nullptr, kOssl);
+    verifier.setTrustedCertificates(m_trusted);
+    QCA::SecureMessage check(&verifier);
+    check.startVerify();
+    check.update(signedText);
+    check.end();
+    check.waitForFinished(-1);
+    QVERIFY(check.wasSigned());
+    QVERIFY(check.verifySuccess());
+    // (qca-ossl does not return the content of a verified message)
+
+    // the signature covers the content
+    QByteArray tampered = signedText;
+    const int  at       = tampered.indexOf(text);
+    QVERIFY(at > 0);
+    tampered[at] = 'S';
+    QCA::SecureMessage checkTampered(&verifier);
+    checkTampered.startVerify();
+    checkTampered.update(tampered);
+    checkTampered.end();
+    checkTampered.waitForFinished(-1);
+    QVERIFY(!checkTampered.verifySuccess());
+}
+
+// CMS decryption by a keystore key
+void KeystoreKeyUnitTest::cmsDecrypt()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+    m_counters.reset();
+
+    QCA::SecureMessageKey recipient;
+    recipient.setX509CertificateChain(QCA::CertificateChain(m_cert));
+
+    const QByteArray   text("for the keystore key only");
+    QCA::CMS           cms(nullptr, kOssl);
+    QCA::SecureMessage msg(&cms);
+    msg.setRecipient(recipient);
+    msg.startEncrypt();
+    msg.update(text);
+    msg.end();
+    msg.waitForFinished(-1);
+    const QByteArray encrypted = msg.read();
+    QVERIFY(!encrypted.isEmpty());
+
+    QCA::SecureMessageKey holder;
+    holder.setX509CertificateChain(QCA::CertificateChain(m_cert));
+    holder.setX509PrivateKey(keystoreKey(m_key));
+    QCA::CMS decryptor(nullptr, kOssl);
+    decryptor.setPrivateKeys(QCA::SecureMessageKeyList() << holder);
+    QCA::SecureMessage dec(&decryptor);
+    dec.startDecrypt();
+    dec.update(encrypted);
+    dec.end();
+    dec.waitForFinished(-1);
+    QCOMPARE(dec.read(), text);
+    QVERIFY(m_counters.decrypt > 0);
+}
+
+// The OpenSSL provider behind keystore keys lives in the plugin. Unloading and loading the
+// plugins again must leave OpenSSL with a working one.
+void KeystoreKeyUnitTest::pluginReload()
+{
+    if (!m_supported)
+        QSKIP("qca-ossl TLS/CMS not available");
+
+    // nothing of qca-ossl may outlive the plugin
+    m_trusted = QCA::CertificateCollection();
+    m_cert    = QCA::Certificate();
+    m_key     = QCA::RSAPrivateKey();
+    QCA::unloadAllPlugins();
+    QCA::scanForPlugins();
+    QVERIFY(QCA::isSupported("tls", kOssl));
+
+    createIdentity();
+    tlsServerSignature();
+    tlsClientSignature();
+}
+
+QTEST_MAIN(KeystoreKeyUnitTest)
