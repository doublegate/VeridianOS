+// Data fed in pieces, a copy taken half way that then goes its own way, reuse after final(),
+// and an empty key.
+void MACUnitTest::HMACIncrementalCopy()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!QCA::isSupported("hmac(sha256)", provider))
+        QSKIP("HMAC(SHA256) not supported for qca-ossl");
+
+    // RFC 4231 test case 2
+    const QString expected = QStringLiteral("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
+    // the same key with " and more" appended to the data
+    const QString expectedLonger = QStringLiteral("286d5b971b51fae9efacd7945e815746e53c41b6e4b07c74baef37d71071f0bc");
+
+    QCA::MessageAuthenticationCode hmac(
+        QStringLiteral("hmac(sha256)"), QCA::SymmetricKey(QCA::SecureArray("Jefe")), provider);
+    hmac.update(QCA::SecureArray("what do "));
+    hmac.update(QCA::SecureArray("ya want"));
+
+    // the copy carries the key and the data so far
+    QCA::MessageAuthenticationCode copy = hmac;
+    copy.context(); // detach
+
+    hmac.update(QCA::SecureArray(" for nothing?"));
+    QCOMPARE(QCA::arrayToHex(hmac.final().toByteArray()), expected);
+
+    copy.update(QCA::SecureArray(" for "));
+    copy.update(QCA::SecureArray("nothing? and more"));
+    QCOMPARE(QCA::arrayToHex(copy.final().toByteArray()), expectedLonger);
+
+    // final() did not disturb the other one
+    QCOMPARE(QCA::arrayToHex(hmac.final().toByteArray()), expected);
+
+    // after clear() the same key is used again
+    hmac.clear();
+    hmac.update(QCA::SecureArray("what do ya want for nothing?"));
+    QCOMPARE(QCA::arrayToHex(hmac.final().toByteArray()), expected);
+
+    // a copy of a fresh object, with nothing fed yet
+    QCA::MessageAuthenticationCode fresh(
+        QStringLiteral("hmac(sha256)"), QCA::SymmetricKey(QCA::SecureArray("Jefe")), provider);
+    QCA::MessageAuthenticationCode freshCopy = fresh;
+    freshCopy.context(); // detach
+    freshCopy.update(QCA::SecureArray("what do ya want for nothing?"));
+    QCOMPARE(QCA::arrayToHex(freshCopy.final().toByteArray()), expected);
+
+    // empty key and empty data
+    QCA::MessageAuthenticationCode empty(QStringLiteral("hmac(sha256)"), QCA::SymmetricKey(), provider);
+    QCOMPARE(QCA::arrayToHex(empty.final().toByteArray()),
+             QStringLiteral("b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad"));
+}
