+static bool rsaSupported(const QString &provider)
+{
+    return QCA::isSupported("pkey", provider) && QCA::PKey::supportedTypes(provider).contains(QCA::PKey::RSA) &&
+        QCA::PKey::supportedIOTypes(provider).contains(QCA::PKey::RSA);
+}
+
+static int byteAt(const QCA::SecureArray &a, int i)
+{
+    return static_cast<unsigned char>(a[i]);
+}
+
+// The padding of every direction, looked at through raw (unpadded) RSA in the opposite direction
+void RSAUnitTest::testRawPadding()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!rsaSupported(provider))
+        QSKIP("RSA not supported. skipping");
+
+    QCA::RSAPrivateKey priv = QCA::KeyGenerator().createRSA(1024, 65537, provider).toRSA();
+    QVERIFY(!priv.isNull());
+    QCA::RSAPublicKey pub = priv.toPublicKey().toRSA();
+    QVERIFY(!pub.isNull());
+
+    const int              modulusBytes = 128;
+    const QCA::SecureArray message("raw padding test");
+    const int              separator = modulusBytes - message.size() - 1; // index of the 00 before the message
+    QCA::SecureArray       block, plain;
+
+    // PKCS#1 v1.5 encryption: 00 02, nonzero random padding, 00, message
+    QCA::SecureArray cipher = pub.encrypt(message, QCA::EME_PKCS1v15);
+    QCOMPARE(cipher.size(), modulusBytes);
+    QVERIFY(priv.decrypt(cipher, &block, QCA::EME_NO_PADDING));
+    QCOMPARE(block.size(), modulusBytes);
+    QCOMPARE(byteAt(block, 0), 0);
+    QCOMPARE(byteAt(block, 1), 2);
+    for (int i = 2; i < separator; ++i)
+        QVERIFY(byteAt(block, i) != 0);
+    QCOMPARE(byteAt(block, separator), 0);
+    QCOMPARE(block.toByteArray().right(message.size()), message.toByteArray());
+
+    // OAEP: the encoded message starts with a zero byte and is otherwise unrecognisable
+    cipher = pub.encrypt(message, QCA::EME_PKCS1_OAEP);
+    QCOMPARE(cipher.size(), modulusBytes);
+    QVERIFY(priv.decrypt(cipher, &block, QCA::EME_NO_PADDING));
+    QCOMPARE(block.size(), modulusBytes);
+    QCOMPARE(byteAt(block, 0), 0);
+    QVERIFY(!block.toByteArray().contains(message.toByteArray()));
+    QVERIFY(priv.decrypt(cipher, &plain, QCA::EME_PKCS1_OAEP));
+    QCOMPARE(plain, message);
+
+    // PKCS#1 v1.5 with the private key (block type 1): 00 01, FF padding, 00, message
+    cipher = priv.encrypt(message, QCA::EME_PKCS1v15);
+    QCOMPARE(cipher.size(), modulusBytes);
+    QVERIFY(pub.decrypt(cipher, &block, QCA::EME_NO_PADDING));
+    QCOMPARE(block.size(), modulusBytes);
+    QCOMPARE(byteAt(block, 0), 0);
+    QCOMPARE(byteAt(block, 1), 1);
+    for (int i = 2; i < separator; ++i)
+        QCOMPARE(byteAt(block, i), 0xff);
+    QCOMPARE(byteAt(block, separator), 0);
+    QCOMPARE(block.toByteArray().right(message.size()), message.toByteArray());
+    QVERIFY(pub.decrypt(cipher, &plain, QCA::EME_PKCS1v15));
+    QCOMPARE(plain, message);
+
+    // OAEP has no private-key direction
+    QVERIFY(priv.encrypt(message, QCA::EME_PKCS1_OAEP).isEmpty());
+    QVERIFY(!pub.decrypt(cipher, &plain, QCA::EME_PKCS1_OAEP));
+
+    // there is no SSLv23 padding in OpenSSL 3
+    QVERIFY(pub.encrypt(message, QCA::EME_PKCS1v15_SSL).isEmpty());
+    QVERIFY(!priv.decrypt(cipher, &plain, QCA::EME_PKCS1v15_SSL));
+
+    // EMSA3_Raw signs the data itself: the same block type 1
+    const QByteArray rawSig = priv.signMessage(message, QCA::EMSA3_Raw);
+    QCOMPARE(rawSig.size(), modulusBytes);
+    QCOMPARE(QCA::SecureArray(rawSig), cipher);
+    QVERIFY(pub.verifyMessage(message, rawSig, QCA::EMSA3_Raw));
+    QVERIFY(!pub.verifyMessage(QCA::SecureArray("another message"), rawSig, QCA::EMSA3_Raw));
+
+    // EMSA3_SHA256 is EMSA3_Raw of the SHA-256 DigestInfo
+    const QByteArray digestInfo = QCA::hexToArray(QStringLiteral("3031300d060960864801650304020105000420")) +
+        QCA::Hash(QStringLiteral("sha256"), provider).hash(message).toByteArray();
+    const QByteArray sha256Sig = priv.signMessage(message, QCA::EMSA3_SHA256);
+    QCOMPARE(sha256Sig, priv.signMessage(digestInfo, QCA::EMSA3_Raw));
+    QVERIFY(pub.verifyMessage(digestInfo, sha256Sig, QCA::EMSA3_Raw));
+    QVERIFY(pub.verifyMessage(message, sha256Sig, QCA::EMSA3_SHA256));
+    QVERIFY(!pub.verifyMessage(message, rawSig, QCA::EMSA3_SHA256));
+}
+
+// Keys built from their components work like the generated key they came from
+void RSAUnitTest::testImportExport()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!rsaSupported(provider))
+        QSKIP("RSA not supported. skipping");
+
+    QCA::RSAPrivateKey orig = QCA::KeyGenerator().createRSA(1024, 65537, provider).toRSA();
+    QVERIFY(!orig.isNull());
+    QCA::RSAPublicKey origPub = orig.toPublicKey().toRSA();
+
+    const QCA::BigInteger n = orig.n(), e = orig.e(), p = orig.p(), q = orig.q(), d = orig.d();
+    QCOMPARE(e, QCA::BigInteger(65537));
+    QCA::BigInteger pq = p;
+    pq *= q;
+    QCOMPARE(pq, n);
+    QCOMPARE(origPub.n(), n);
+    QCOMPARE(origPub.e(), e);
+
+    QCA::RSAPrivateKey imported(n, e, p, q, d, provider);
+    QVERIFY(!imported.isNull());
+    QVERIFY(imported.isPrivate());
+    QCOMPARE(imported.bitSize(), 1024);
+    QCOMPARE(imported.n(), n);
+    QCOMPARE(imported.e(), e);
+    QCOMPARE(imported.p(), p);
+    QCOMPARE(imported.q(), q);
+    QCOMPARE(imported.d(), d);
+
+    const QCA::SecureArray message("import and export");
+    const QByteArray       sig = imported.signMessage(message, QCA::EMSA3_SHA256);
+    QVERIFY(origPub.verifyMessage(message, sig, QCA::EMSA3_SHA256));
+    QCOMPARE(sig, orig.signMessage(message, QCA::EMSA3_SHA256)); // PKCS#1 v1.5 is deterministic
+
+    const QList<QCA::EncryptionAlgorithm> algorithms = {QCA::EME_PKCS1v15, QCA::EME_PKCS1_OAEP};
+    for (QCA::EncryptionAlgorithm alg : algorithms) {
+        QCA::SecureArray plain;
+        QVERIFY(imported.decrypt(origPub.encrypt(message, alg), &plain, alg));
+        QCOMPARE(plain, message);
+    }
+
+    // public key from its components
+    QCA::RSAPublicKey pubFromComponents(n, e, provider);
+    QVERIFY(!pubFromComponents.isNull());
+    QVERIFY(pubFromComponents.isPublic());
+    QCOMPARE(pubFromComponents.bitSize(), 1024);
+    QCOMPARE(pubFromComponents.n(), n);
+    QCOMPARE(pubFromComponents.e(), e);
+    QVERIFY(pubFromComponents.verifyMessage(message, sig, QCA::EMSA3_SHA256));
+    QCOMPARE(pubFromComponents.toDER(), origPub.toDER());
+
+    // the public half of the imported key
+    QCA::RSAPublicKey converted = imported.toPublicKey().toRSA();
+    QVERIFY(!converted.isNull());
+    QVERIFY(converted.isPublic());
+    QVERIFY(!converted.isPrivate());
+    QCOMPARE(converted.n(), n);
+    QCOMPARE(converted.e(), e);
+    QVERIFY(converted.verifyMessage(message, sig, QCA::EMSA3_SHA256));
+    QCOMPARE(converted.toDER(), origPub.toDER());
+    QCA::SecureArray plain;
+    QVERIFY(orig.decrypt(converted.encrypt(message, QCA::EME_PKCS1_OAEP), &plain, QCA::EME_PKCS1_OAEP));
+    QCOMPARE(plain, message);
+}
+
+// A private key given without e or without d gets the missing exponent computed from the other
+// one and the factors. (Before the OpenSSL 3 port, a key without e worked with RSA blinding
+// switched off and reported e == 0, and a key without d gave wrong results.)
+void RSAUnitTest::testMissingExponent()
+{
+    const QString provider = QStringLiteral("qca-ossl");
+    if (!rsaSupported(provider))
+        QSKIP("RSA not supported. skipping");
+
+    QCA::RSAPrivateKey orig = QCA::KeyGenerator().createRSA(1024, 65537, provider).toRSA();
+    QVERIFY(!orig.isNull());
+    QCA::RSAPublicKey origPub = orig.toPublicKey().toRSA();
+
+    const QCA::BigInteger  n = orig.n(), e = orig.e(), p = orig.p(), q = orig.q(), d = orig.d();
+    const QCA::SecureArray message("missing exponent");
+    const QByteArray       sig = orig.signMessage(message, QCA::EMSA3_SHA256);
+
+    QCA::RSAPrivateKey noE(n, QCA::BigInteger(0), p, q, d, provider);
+    QVERIFY(!noE.isNull());
+    QCOMPARE(noE.e(), e);
+    QCA::SecureArray plain;
+    QVERIFY(noE.decrypt(origPub.encrypt(message, QCA::EME_PKCS1v15), &plain, QCA::EME_PKCS1v15));
+    QCOMPARE(plain, message);
+    QCOMPARE(noE.signMessage(message, QCA::EMSA3_SHA256), sig);
+
+    QCA::RSAPrivateKey noD(n, e, p, q, QCA::BigInteger(0), provider);
+    QVERIFY(!noD.isNull());
+    QVERIFY(noD.d() != QCA::BigInteger(0));
+    QVERIFY(noD.decrypt(origPub.encrypt(message, QCA::EME_PKCS1_OAEP), &plain, QCA::EME_PKCS1_OAEP));
+    QCOMPARE(plain, message);
+    QCOMPARE(noD.signMessage(message, QCA::EMSA3_SHA256), sig);
+
+    // nothing to compute them from: there is no key (PKey::isNull() only reports a missing context)
+    QCA::RSAPrivateKey neither(n, QCA::BigInteger(0), p, q, QCA::BigInteger(0), provider);
+    QCOMPARE(neither.bitSize(), 0);
+    QVERIFY(!neither.decrypt(origPub.encrypt(message, QCA::EME_PKCS1v15), &plain, QCA::EME_PKCS1v15));
+}
+
