+static bool loadProvider()
+{
+    std::lock_guard<std::mutex> locker(s_providerLock);
+    if (s_provider)
+        return true;
+    if (s_providerName.empty()) {
+        // OpenSSL keeps built-in provider registrations, with their init function, for the life of
+        // the process, and looks them up by name. This plugin may be unloaded and loaded again at
+        // another address, so the name carries the address of the init function: a later load
+        // never reaches a stale registration.
+        const std::string name =
+            "qca-keystore-" + QByteArray::number(reinterpret_cast<quintptr>(&providerInit), 16).toStdString();
+        if (!OSSL_PROVIDER_add_builtin(nullptr, name.c_str(), providerInit))
+            return false;
+        s_providerName = name;
+    }
+    s_provider = OSSL_PROVIDER_load(nullptr, s_providerName.c_str());
+    return s_provider != nullptr;
