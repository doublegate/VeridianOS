+// For private key components: OSSL_PARAM_BLD keeps the value of a secure BIGNUM in a block that
+// OSSL_PARAM_free() cleanses.
+static BIGNUM *bi2bn_secure(const BigInteger &n)
+{
+    BIGNUM *bn = BN_secure_new();
+    if (!bn)
+        return nullptr;
+    SecureArray buf = n.toArray();
+    if (!BN_bin2bn((const unsigned char *)buf.data(), buf.size(), bn)) {
+        BN_clear_free(bn);
+        return nullptr;
+    }
+    return bn;
+}
+
+// Reads a BIGNUM key parameter (OSSL_PKEY_PARAM_*). A parameter the key does not have reads as
+// zero, which is also what an absent component looked like through the old RSA/DSA/DH getters.
+static BigInteger pkey_get_bi(const EVP_PKEY *pkey, const char *name)
+{
+    BIGNUM *bn = nullptr;
+    if (!pkey || EVP_PKEY_get_bn_param(pkey, name, &bn) != 1 || !bn) {
+        ERR_clear_error();
+        return BigInteger(0);
+    }
+    BigInteger bi = bn2bi(bn);
+    BN_clear_free(bn);
+    return bi;
+}
+
+// Builds a key of the given OpenSSL key type ("RSA", "DSA", "DH") from OSSL_PARAMs.
+// selection is EVP_PKEY_KEYPAIR, EVP_PKEY_PUBLIC_KEY or EVP_PKEY_KEY_PARAMETERS.
+static EVP_PKEY *pkey_from_params(const char *type, int selection, const OSSL_PARAM *params)
+{
+    EvpPkeyCtxPtr ctx(EVP_PKEY_CTX_new_from_name(nullptr, type, kNativeKeyPropq));
+    EVP_PKEY     *pkey = nullptr;
+    if (!ctx || EVP_PKEY_fromdata_init(ctx.get()) <= 0 ||
+        EVP_PKEY_fromdata(ctx.get(), &pkey, selection, const_cast<OSSL_PARAM *>(params)) <= 0)
+        return nullptr;
+    return pkey;
+}
+
+static EVP_PKEY *pkey_from_builder(const char *type, int selection, OSSL_PARAM_BLD *bld)
+{
+    ParamPtr params(OSSL_PARAM_BLD_to_param(bld));
+    if (!params)
+        return nullptr;
+    return pkey_from_params(type, selection, params.get());
+}
+
+// Adds a BIGNUM parameter to bld. The builder copies the value only in OSSL_PARAM_BLD_to_param(),
+// so the BIGNUM is kept alive in holder until then.
+static bool
+bld_push_bi(OSSL_PARAM_BLD *bld, const char *name, const BigInteger &value, bool secret, std::vector<BnPtr> &holder)
+{
+    BnPtr bn(secret ? bi2bn_secure(value) : bi2bn(value));
+    if (!bn || !OSSL_PARAM_BLD_push_BN(bld, name, bn.get()))
+        return false;
+    holder.push_back(std::move(bn));
+    return true;
+}
+
+// A copy of pkey holding only its public half and domain parameters. This replaces the
+// i2d_RSAPublicKey/d2i_RSAPublicKey (and DSA equivalents) round trip of the old code: the result is
+// the same key, without the private components, built by the same key manager.
+static EVP_PKEY *pkey_public_copy(EVP_PKEY *pkey)
+{
+    OSSL_PARAM *raw = nullptr;
+    if (!pkey || EVP_PKEY_todata(pkey, EVP_PKEY_PUBLIC_KEY, &raw) != 1)
+        return nullptr;
+    ParamPtr params(raw);
+    return pkey_from_params(EVP_PKEY_get0_type_name(pkey), EVP_PKEY_PUBLIC_KEY, params.get());
+}
