VeridianOS: KPty::logout clears the whole name and host fields

logout() marks the terminal's utmp entry dead and clears its user name
and host with memset(ut->ut_name, 0, sizeof(*ut->ut_name)): the size of
one character, so only the first byte of each was cleared and the rest of
the logged-out user's name and host stayed in the record. The whole
arrays are cleared now (sizeof(ut->ut_name), sizeof(ut->ut_host)).

--- a/src/kpty.cpp
+++ b/src/kpty.cpp
@@ -594,8 +594,8 @@
     setutent();
     if ((ut = getutline(&l_struct))) {
 #endif
-        memset(ut->ut_name, 0, sizeof(*ut->ut_name));
-        memset(ut->ut_host, 0, sizeof(*ut->ut_host));
+        memset(ut->ut_name, 0, sizeof(ut->ut_name));
+        memset(ut->ut_host, 0, sizeof(ut->ut_host));
 #if HAVE_STRUCT_UTMP_UT_SYSLEN
         ut->ut_syslen = 0;
 #endif
