     KF6::ColorScheme
 )
 if(TARGET KF6::Crash)
diff -ru a/src/app/kirigamiapp.cpp b/src/app/kirigamiapp.cpp
--- a/src/app/kirigamiapp.cpp	2026-10-08 17:22:17.216141298 -0400
+++ b/src/app/kirigamiapp.cpp	2026-10-08 17:22:17.304685814 -0400
@@ -9,7 +9,7 @@
 #include <QQmlApplicationEngine>
 #include <QQmlContext>
 
-#include <KLocalizedContext>
+#include <KLocalizedQmlContext>
 
 #include "kirigamiappdefaults.h"
 
@@ -30,9 +30,16 @@
 bool KirigamiApp::start(QAnyStringView uri, QAnyStringView typeName, QQmlApplicationEngine *engine)
 {
     Q_ASSERT(engine);
-    if (!qobject_cast<KLocalizedContext *>(engine->rootContext()->contextObject())) {
-        // Ensure the i18n() infrastructure is available
-        engine->rootContext()->setContextObject(new KLocalizedContext(engine));
+    const QObject *contextObject = engine->rootContext()->contextObject();
+    // Keep a localized context the application installed itself (KLocalizedQmlContext,
+    // or the deprecated KLocalizedContext, checked by name to avoid the deprecated type).
+    if (!qobject_cast<const KLocalizedQmlContext *>(contextObject) && !(contextObject && contextObject->inherits("KLocalizedContext"))) {
+        // Ensure the i18n() infrastructure is available. Same as
+        // KLocalization::setupLocalizedContext(), but without applying this library's
+        // TRANSLATION_DOMAIN to the application's QML.
+        auto *localizedContext = new KLocalizedQmlContext(engine);
+        engine->rootContext()->setContextObject(localizedContext);
+        QQmlEngine::setContextForObject(localizedContext, engine->rootContext());
     }
     engine->loadFromModule(uri, typeName);
     return !engine->rootObjects().isEmpty();
