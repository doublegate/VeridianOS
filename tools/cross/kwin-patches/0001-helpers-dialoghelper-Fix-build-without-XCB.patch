From b0d9e8083951125348bd19761b216d20a56c149a Mon Sep 17 00:00:00 2001
From: Vlad Zahorodnii <vlad.zahorodnii@kde.org>
Date: Tue, 6 Oct 2026 12:20:52 +0300
Subject: [PATCH] helpers/dialoghelper: Fix build without XCB

CCBUG: 526689
---
 src/helpers/dialoghelper/CMakeLists.txt   |  5 ++++-
 src/helpers/dialoghelper/dialoghelper.cpp | 16 +++++++++++-----
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/helpers/dialoghelper/CMakeLists.txt b/src/helpers/dialoghelper/CMakeLists.txt
index be7f53ac014..03cb16651f7 100644
--- a/src/helpers/dialoghelper/CMakeLists.txt
+++ b/src/helpers/dialoghelper/CMakeLists.txt
@@ -10,10 +10,13 @@ target_link_libraries(kwin_dialog_helper
     KF6::I18n
     KF6::WidgetsAddons
     KF6::WindowSystem
-    Qt::GuiPrivate
     Qt::Widgets
 )
 
+if (KWIN_BUILD_X11)
+    target_link_libraries(kwin_dialog_helper Qt::GuiPrivate)
+endif()
+
 install(TARGETS kwin_dialog_helper DESTINATION ${KDE_INSTALL_LIBEXECDIR})
 
 configure_file(org.kde.kwin.dialoghelper.desktop.in ${CMAKE_CURRENT_BINARY_DIR}/org.kde.kwin.dialoghelper.desktop @ONLY)
diff --git a/src/helpers/dialoghelper/dialoghelper.cpp b/src/helpers/dialoghelper/dialoghelper.cpp
index f2504d7b94a..09d71c97a4a 100644
--- a/src/helpers/dialoghelper/dialoghelper.cpp
+++ b/src/helpers/dialoghelper/dialoghelper.cpp
@@ -17,10 +17,10 @@
 #include <QCommandLineParser>
 #include <QKeySequence>
 
-#include <qpa/qplatformwindow_p.h>
-
+#if KWIN_BUILD_X11
 #include <private/qtx11extras_p.h>
 #include <xcb/xcb.h>
+#endif
 
 static QString shortcut(const QString &name)
 {
@@ -55,16 +55,20 @@ int main(int argc, char *argv[])
 
     parser.process(app);
 
-    const bool isX11 = app.platformName() == QLatin1StringView("xcb");
-
     QString windowHandle = parser.value(widOption);
 
+#if KWIN_BUILD_X11
     // on Wayland XDG_ACTIVATION_TOKEN is set in the environment.
+    const bool isX11 = app.platformName() == QLatin1StringView("xcb");
     bool time_ok = false;
     xcb_timestamp_t timestamp = parser.value(timestampOption).toULong(&time_ok);
+#endif
 
     if (windowHandle.isEmpty()
-        || (isX11 && (!time_ok || timestamp == XCB_CURRENT_TIME))) {
+#if KWIN_BUILD_X11
+        || (isX11 && (!time_ok || timestamp == XCB_CURRENT_TIME))
+#endif
+    ) {
         fprintf(stdout, "%s\n", qPrintable(i18n("This helper utility is not supposed to be called directly.")));
         parser.showHelp(1);
     }
@@ -119,9 +123,11 @@ int main(int argc, char *argv[])
         parser.showHelp(1);
     }
 
+#if KWIN_BUILD_X11
     if (isX11) {
         QX11Info::setAppUserTime(timestamp);
     }
+#endif
 
     // KMessageDialog::Information doesn't let us add additional buttons...
     auto *dialog = new KMessageDialog(KMessageDialog::QuestionTwoActions, prompt);
-- 
