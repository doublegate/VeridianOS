# Initial cache for every KDE CMake project (lib/kde-build.sh kde_cmake,
# loaded with -C). These are defaults for the whole stack; a project reads
# the ones its own CMake files or the ECM modules it includes define, and
# a -D on the command line still overrides any of them. Given on the
# command line instead, each one a project never reads drew CMake's
# "Manually-specified variables were not used" warning -- about a hundred
# across a build.

# No tests, Qt help collections, Python bindings or Qt Designer plugins.
set(BUILD_TESTING OFF CACHE BOOL "")
set(BUILD_QCH OFF CACHE BOOL "")
set(BUILD_PYTHON_BINDINGS OFF CACHE BOOL "")
set(BUILD_DESIGNERPLUGIN OFF CACHE BOOL "")
# ECMCheckOutboundLicense generates license tests, which need the reuse
# tool; with BUILD_TESTING off there are no tests to generate.
set(SKIP_LICENSE_TESTS ON CACHE BOOL "")

# Plugins, QML modules and metatypes go into the target Qt's directories
# (build-qt6.sh lays Qt out under /usr/lib/qt6). They are given rather than
# queried: ECM's query (KDE_INSTALL_USE_QT_SYS_PATHS) runs the host Qt's
# qtpaths, which answers with the host Qt's directories.
set(KDE_INSTALL_USE_QT_SYS_PATHS OFF CACHE BOOL "")
set(KDE_INSTALL_QTPLUGINDIR lib/qt6/plugins CACHE PATH "")
set(KDE_INSTALL_QMLDIR lib/qt6/qml CACHE PATH "")
set(KDE_INSTALL_QTMETATYPESDIR lib/qt6/metatypes CACHE PATH "")

# No X11 support unless a project asks for it (-DWITH_X11=ON).
set(WITH_X11 OFF CACHE BOOL "")

# CMake 4 policies the KDE sources predate, set to their new behaviour:
# cmake_dependent_option conditions use the full condition syntax
# (CMP0127); Boost is found through the BoostConfig.cmake Boost installs,
# as FindBoost is gone (CMP0167); install() DESTINATION paths are
# normalized (CMP0177).
set(CMAKE_POLICY_DEFAULT_CMP0127 NEW CACHE STRING "")
set(CMAKE_POLICY_DEFAULT_CMP0167 NEW CACHE STRING "")
set(CMAKE_POLICY_DEFAULT_CMP0177 NEW CACHE STRING "")

# Qt policies the KDE sources predate, set to their new behaviour (each is
# NEW by default for a project that declares Qt 6.8 or later through
# qt_standard_project_setup, which these do not). Qt reads a policy from
# __QT_INTERNAL_POLICY_<id>, the variable qt_policy(SET) writes; qt_policy
# itself cannot be called here, before a project has found Qt.
# QTP0004: QML modules get a qmldir file in each extra directory holding
# .qml files, so those directories import as modules. QTP0006: Wayland
# protocol code generated by qt_generate_wayland_protocol_client_sources
# is private to the target that generates it.
set(__QT_INTERNAL_POLICY_QTP0004 NEW CACHE INTERNAL "")
set(__QT_INTERNAL_POLICY_QTP0006 NEW CACHE INTERNAL "")
