# VeridianOS tools other packages installed, run on the build host; and the
# Qt metatypes of the libraries each project installs (at the end of this
# file).
#
# Loaded into every Qt/KDE CMake project (CMAKE_PROJECT_INCLUDE, set by
# cmake-toolchain-veridian.cmake). Packages run tools that earlier packages
# installed into the sysroot -- KConfig's kconfig_compiler, for instance --
# as imported executables (KF6::kconfig_compiler_kf6). Those are VeridianOS
# programs, dynamically linked against the sysroot's libraries (ADR 0010),
# which the build host cannot start directly, and CMake applies its
# cross-compiling emulator only to executables the project builds itself.
#
# After each find_package(), every imported executable it created whose
# file is in the sysroot is pointed at a small script that runs that file
# through the target launcher (${VERIDIAN_RUN_TARGET}, lib/cross-env.sh).
# Commands naming the target ($<TARGET_FILE:...>, or the target name) then
# run the wrapper. Executables from elsewhere (the host Qt's moc, ...) are
# left as they are.

include_guard(GLOBAL)

set(_VERIDIAN_TT_SYSROOT "${CMAKE_SYSROOT}")
set(_VERIDIAN_TT_DIR "${CMAKE_BINARY_DIR}/veridian-target-tools")

function(_veridian_tt_wrap target)
    get_target_property(type ${target} TYPE)
    get_target_property(imported ${target} IMPORTED)
    if(NOT type STREQUAL "EXECUTABLE" OR NOT imported)
        return()
    endif()
    get_target_property(done ${target} _VERIDIAN_TT_DONE)
    if(done)
        return()
    endif()
    string(LENGTH "${_VERIDIAN_TT_SYSROOT}/" root_len)
    foreach(prop IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_NOCONFIG
                 IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_LOCATION_DEBUG)
        get_target_property(location ${target} ${prop})
        if(NOT location)
            continue()
        endif()
        string(SUBSTRING "${location}" 0 ${root_len} head)
        if(NOT head STREQUAL "${_VERIDIAN_TT_SYSROOT}/")
            continue()
        endif()
        get_filename_component(name "${location}" NAME)
        set(wrapper "${_VERIDIAN_TT_DIR}/${name}")
        file(WRITE "${wrapper}"
             "#!/bin/sh\n# ${target}: generated by tools/cross/cmake/VeridianTargetTools.cmake\n"
             "exec \"${VERIDIAN_RUN_TARGET}\" \"${location}\" \"$@\"\n")
        file(CHMOD "${wrapper}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
             GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        set_property(TARGET ${target} PROPERTY ${prop} "${wrapper}")
    endforeach()
    set_property(TARGET ${target} PROPERTY _VERIDIAN_TT_DONE TRUE)
endfunction()

function(_veridian_tt_wrap_all)
    get_property(targets DIRECTORY PROPERTY IMPORTED_TARGETS)
    foreach(target IN LISTS targets)
        _veridian_tt_wrap(${target})
    endforeach()
endfunction()

# A macro, so that find_package's results land in the caller's scope as
# usual; the previous find_package stays reachable as _find_package.
# Every imported executable not yet wrapped is wrapped afterwards (each
# once): a package's config often calls find_dependency() after creating
# its targets, and that nested find_package shares this macro's variables,
# so a before/after comparison missed the outer package's tools
# (KF6::meinproc6, created before KF6DocTools' find_dependency(Qt6Core)).
macro(find_package)
    _find_package(${ARGV})
    _veridian_tt_wrap_all()
endmacro()

# Qt metatypes of the libraries a project installs.
#
# A QML module's types are registered by qmltyperegistrar, which describes
# each type's base classes and foreign types from the metatypes of the
# libraries that declare them -- collected from the module's link
# dependencies (their INTERFACE_SOURCES; see Qt6QmlMacros). Qt's own
# libraries install and export theirs; KDE's do not, so a QML type deriving
# from, say, PlasmaQuick::PlasmaWindow or KDirModel was described without its
# base ("... is used as base type but cannot be found"), and tooling (qmllint,
# qmlls, the QML compiler) saw incomplete types.
#
# Every shared library a project defines with AUTOMOC (QML modules aside:
# Qt finalizes those itself) now has its metatypes extracted, installed into
# the target Qt's metatypes directory and exported the way Qt exports its
# own, at the end of the directory that defines it.
function(_veridian_export_metatypes target)
    if(NOT TARGET ${target} OR NOT COMMAND qt6_extract_metatypes
       OR NOT COMMAND _qt_internal_assign_install_metatypes_files_and_properties)
        return()
    endif()
    get_target_property(type ${target} TYPE)
    get_target_property(automoc ${target} AUTOMOC)
    get_target_property(qml_uri ${target} QT_QML_MODULE_URI)
    get_target_property(installed ${target} INTERFACE_QT_META_TYPES_INSTALL_FILE)
    if(NOT type STREQUAL "SHARED_LIBRARY" OR NOT automoc OR qml_uri OR installed)
        return()
    endif()
    set(dir "${KDE_INSTALL_QTMETATYPESDIR}")
    if(NOT dir)
        set(dir "lib/qt6/metatypes")
    endif()
    qt6_extract_metatypes(${target})
    _qt_internal_assign_install_metatypes_files_and_properties(${target} INSTALL_DIR "${dir}")
    get_target_property(file ${target} INTERFACE_QT_META_TYPES_BUILD_FILE)
    install(FILES "${file}" DESTINATION "${dir}")
endfunction()

# add_library() as before, then the metatypes step deferred to the end of the
# current directory (when the target has all its sources and properties).
macro(add_library _veridian_name)
    _add_library(${_veridian_name} ${ARGN})
    if(NOT "${ARGV1}" MATCHES "^(ALIAS|IMPORTED|INTERFACE|OBJECT|STATIC|MODULE)$")
        cmake_language(DEFER CALL _veridian_export_metatypes ${_veridian_name})
    endif()
endmacro()
